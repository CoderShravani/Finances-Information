# PostgreSQL / Railway
DATABASE_URL=
REQUIRE_POSTGRES=0

# Final Google Sheets + Apps Script sync
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_SYNC_TOKEN=

# Gmail OAuth -> personal Google Drive
# GOOGLE_DRIVE_FOLDER_ID is a folder in the OAuth-authorized Gmail account's My Drive.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_JSON=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Per-family total document storage ceiling
MAX_TOTAL_DOCUMENT_GB=50

# Optional Drive upload tuning; defaults to 32 MB.
DRIVE_UPLOAD_CHUNK_MB=32
